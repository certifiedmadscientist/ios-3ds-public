# Kernel patch list for the iPod touch 1G (n45ap) iPhone OS 1.1.5 (4B1)
# kernelcache, applied by tools/patch_kernel.py to the decrypted and
# decompressed Mach-O.
#
# Format: "@ <file offset>" starts a hunk; "-" lines are the original bytes,
# "+" lines the replacement (hex, concatenated).  "- zeros N" means N zero
# bytes.  Every original byte is checked before anything is written.
# '#' starts a comment.  File offset -> VA: __TEXT is VA 0xC0008000 at file
# offset 0, __DATA is VA 0xC01A5000 at 0x19D000, __PRELINK is VA 0xC029B000
# at 0x1F4000.
#
# md5 of the unpatched Mach-O and of the result, checked by patch_kernel.py:
input-md5  2f5a6ab6c77daf3a4400f384c0b86aaf
output-md5 50bed0aaf1baf0ea266b852a447df6ac

# _ml_get_timebase fallback (VA 0xC006156C).  When no platform timebase
# hook is registered, the stock code spins reading timer registers.  Read the
# ARM11 MPCore cycle counter instead (ARMv6 encoding; the 3DS has no ARMv7
# c9 PMU):  mrc p15,0,r0,c15,c12,1 ; mov r1,#0 ; bx lr ; nop ; nop
@ 0x5956c
- 602093e55c0093e5601093e5020051e1faffff1a
+ 3c0f1fee0010a0e31eff2fe10000a0e10000a0e1

# IOPanicPlatform::start (VA 0xC014C500, Thumb): return true at once
# (movs r0,#1 ; bx lr) so the panic platform does not stop IOKit matching.
@ 0x144500
- 80b500af
+ 01207047

# _PE_init_iokit+0x44 (VA 0xC0160358, Thumb): drop the boot-logo wait
# loop (bls -14 -> nop).
@ 0x158358
- f9d9eb61
+ c046eb61

# Code cave at VA 0xC0184F38 (unused zero-filled space in __TEXT):
# handlers for BSD syscalls 366 (framebuffer blit via copyin) and 367
# (framebuffer geometry via copyout).  Wired into sysent below.
@ 0x17cf38
- zeros 256
+ f0412de90d70a0e10280a0e1004091e5045091e5086091e5c4309fe5030055e1
+ 140000cabc309fe5000093e5000050e30500001ab0009fe50116a0e3ac309fe5
+ 33ff2fe19c309fe5000083e5000056e30030a00398309f15030080e00520a0e1
+ 0010a0e10400a0e188309fe533ff2fe1000088e5f081bde81600a0e3000088e5
+ 1600a0e3f081bde80000000010402de9004091e518d04de2193ea0e300308de5
+ f030a0e304308de5053da0e308308de5f030a0e30c308de50330a0e310308de5
+ 0130a0e314308de50d00a0e10410a0e11820a0e320309fe533ff2fe118d08de2
+ 1080bde800650400c04f18c000003018df0d06c000ca3800481306c0bc1306c0

# Code cave at VA 0xC01A4D8C (unused zero-filled space in __TEXT): the
# Mach trap -10 framebuffer handler assembled from patches/fb_trap2.S (its
# first 400 bytes; the trailing data word is zero).  The bootloader
# repoints trap -10 to its own handler at run time and checks for this
# address first (boot/main.c).
@ 0x19cd8c
- zeros 400
